# Trailhead local development configuration.
email {
  smtp_host: "localhost"
  smtp_port: 1025
  smtp_encryption: SMTP_ENCRYPTION_NONE
  sender_name: "Trailhead"
  sender_address: "noreply@trailhead.test"
  user_verification_template {
    subject: "Confirm your trail with {{ APP_NAME }}"
    body: "<!doctype html><html lang='en'><body style='margin:0;padding:0;background:#f7f5ef;color:#18211c;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Arial,sans-serif'><div style='display:none;max-height:0;overflow:hidden;opacity:0'>One quick step, then your next adventure can begin.</div><table role='presentation' width='100%' cellspacing='0' cellpadding='0' border='0' bgcolor='#f7f5ef'><tr><td align='center' style='padding:36px 16px'><table role='presentation' width='600' cellspacing='0' cellpadding='0' border='0' style='width:100%;max-width:600px;background:#fffefb;border:1px solid #dedbd0;border-radius:20px;overflow:hidden'><tr><td height='6' bgcolor='#f1b85b' style='font-size:0;line-height:0'>&nbsp;</td></tr><tr><td bgcolor='#173b2d' style='padding:30px 40px 34px'><table role='presentation' cellspacing='0' cellpadding='0' border='0'><tr><td style='padding-right:13px'><img src='{{ SITE_URL }}/trailhead-logo-email.png' width='48' height='48' alt='' style='display:block;border:0;border-radius:14px'></td><td><div style='color:#ffffff;font-size:21px;line-height:25px;font-weight:800;letter-spacing:-.3px'>Trailhead</div><div style='color:#b9c9c0;font-size:12px;line-height:18px'>Plan together. Go farther.</div></td></tr></table><div style='padding-top:34px;color:#f5c77b;font-size:11px;line-height:16px;font-weight:800;letter-spacing:2px;text-transform:uppercase'>Welcome aboard</div><h1 style='margin:9px 0 0;color:#ffffff;font-size:36px;line-height:42px;letter-spacing:-1px'>Your next adventure starts here.</h1></td></tr><tr><td style='padding:38px 40px 22px'><p style='margin:0 0 18px;font-size:16px;line-height:26px'>Hi {{ EMAIL }},</p><p style='margin:0 0 28px;color:#4e5c54;font-size:16px;line-height:26px'>Thanks for joining {{ APP_NAME }}. Confirm your email address so your trips, plans, and travel crew stay securely connected.</p><table role='presentation' cellspacing='0' cellpadding='0' border='0'><tr><td bgcolor='#f1b85b' style='border-radius:12px'><a href='{{ VERIFICATION_URL }}' style='display:inline-block;padding:15px 24px;color:#173b2d;font-size:15px;line-height:20px;font-weight:800;text-decoration:none'>Verify my email &rarr;</a></td></tr></table><p style='margin:28px 0 8px;color:#68716b;font-size:12px;line-height:19px'>Button not working? Copy and paste this secure link:</p><p style='margin:0;overflow-wrap:anywhere;word-break:break-word;font-size:12px;line-height:19px'><a href='{{ VERIFICATION_URL }}' style='color:#1c6748;text-decoration:underline'>{{ VERIFICATION_URL }}</a></p></td></tr><tr><td style='padding:18px 40px 34px'><table role='presentation' width='100%' cellspacing='0' cellpadding='0' border='0' bgcolor='#eeece4' style='border-radius:12px'><tr><td style='padding:17px 18px;color:#5c665f;font-size:13px;line-height:20px'><strong style='color:#173b2d'>Didn’t create this account?</strong><br>You can safely ignore this email. Nothing changes until the link is opened.</td></tr></table></td></tr><tr><td align='center' bgcolor='#173b2d' style='padding:24px 32px;color:#9fb2a7;font-size:12px;line-height:19px'>Sent by Trailhead &middot; Built for the journeys worth sharing.<br><a href='{{ SITE_URL }}' style='color:#f5c77b;text-decoration:none'>{{ SITE_URL }}</a></td></tr></table></td></tr></table></body></html>"
  }
  change_email_template {
    subject: "Confirm your new email for {{ APP_NAME }}"
    body: "<!doctype html><html lang='en'><body style='margin:0;padding:0;background:#f7f5ef;color:#18211c;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Arial,sans-serif'><div style='display:none;max-height:0;overflow:hidden;opacity:0'>Confirm this address to keep your Trailhead account on course.</div><table role='presentation' width='100%' cellspacing='0' cellpadding='0' border='0' bgcolor='#f7f5ef'><tr><td align='center' style='padding:36px 16px'><table role='presentation' width='600' cellspacing='0' cellpadding='0' border='0' style='width:100%;max-width:600px;background:#fffefb;border:1px solid #dedbd0;border-radius:20px;overflow:hidden'><tr><td height='6' bgcolor='#f1b85b' style='font-size:0;line-height:0'>&nbsp;</td></tr><tr><td bgcolor='#173b2d' style='padding:30px 40px 34px'><table role='presentation' cellspacing='0' cellpadding='0' border='0'><tr><td style='padding-right:13px'><img src='{{ SITE_URL }}/trailhead-logo-email.png' width='48' height='48' alt='' style='display:block;border:0;border-radius:14px'></td><td><div style='color:#ffffff;font-size:21px;line-height:25px;font-weight:800;letter-spacing:-.3px'>Trailhead</div><div style='color:#b9c9c0;font-size:12px;line-height:18px'>Plan together. Go farther.</div></td></tr></table><div style='padding-top:34px;color:#f5c77b;font-size:11px;line-height:16px;font-weight:800;letter-spacing:2px;text-transform:uppercase'>Account update</div><h1 style='margin:9px 0 0;color:#ffffff;font-size:36px;line-height:42px;letter-spacing:-1px'>Keep your account on course.</h1></td></tr><tr><td style='padding:38px 40px 22px'><p style='margin:0 0 18px;font-size:16px;line-height:26px'>Hi {{ EMAIL }},</p><p style='margin:0 0 28px;color:#4e5c54;font-size:16px;line-height:26px'>Use the button below to confirm this as the new email address for your {{ APP_NAME }} account.</p><table role='presentation' cellspacing='0' cellpadding='0' border='0'><tr><td bgcolor='#f1b85b' style='border-radius:12px'><a href='{{ VERIFICATION_URL }}' style='display:inline-block;padding:15px 24px;color:#173b2d;font-size:15px;line-height:20px;font-weight:800;text-decoration:none'>Confirm new email &rarr;</a></td></tr></table><p style='margin:28px 0 8px;color:#68716b;font-size:12px;line-height:19px'>Button not working? Copy and paste this secure link:</p><p style='margin:0;overflow-wrap:anywhere;word-break:break-word;font-size:12px;line-height:19px'><a href='{{ VERIFICATION_URL }}' style='color:#1c6748;text-decoration:underline'>{{ VERIFICATION_URL }}</a></p></td></tr><tr><td style='padding:18px 40px 34px'><table role='presentation' width='100%' cellspacing='0' cellpadding='0' border='0' bgcolor='#eeece4' style='border-radius:12px'><tr><td style='padding:17px 18px;color:#5c665f;font-size:13px;line-height:20px'><strong style='color:#173b2d'>Didn’t request this change?</strong><br>Do not open the link. Your current email address remains unchanged.</td></tr></table></td></tr><tr><td align='center' bgcolor='#173b2d' style='padding:24px 32px;color:#9fb2a7;font-size:12px;line-height:19px'>Sent by Trailhead &middot; Built for the journeys worth sharing.<br><a href='{{ SITE_URL }}' style='color:#f5c77b;text-decoration:none'>{{ SITE_URL }}</a></td></tr></table></td></tr></table></body></html>"
  }
  password_reset_template {
    subject: "Reset your {{ APP_NAME }} password"
    body: "<!doctype html><html lang='en'><body style='margin:0;padding:0;background:#f7f5ef;color:#18211c;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Arial,sans-serif'><div style='display:none;max-height:0;overflow:hidden;opacity:0'>Choose a new password and get back to planning.</div><table role='presentation' width='100%' cellspacing='0' cellpadding='0' border='0' bgcolor='#f7f5ef'><tr><td align='center' style='padding:36px 16px'><table role='presentation' width='600' cellspacing='0' cellpadding='0' border='0' style='width:100%;max-width:600px;background:#fffefb;border:1px solid #dedbd0;border-radius:20px;overflow:hidden'><tr><td height='6' bgcolor='#f1b85b' style='font-size:0;line-height:0'>&nbsp;</td></tr><tr><td bgcolor='#173b2d' style='padding:30px 40px 34px'><table role='presentation' cellspacing='0' cellpadding='0' border='0'><tr><td style='padding-right:13px'><img src='{{ SITE_URL }}/trailhead-logo-email.png' width='48' height='48' alt='' style='display:block;border:0;border-radius:14px'></td><td><div style='color:#ffffff;font-size:21px;line-height:25px;font-weight:800;letter-spacing:-.3px'>Trailhead</div><div style='color:#b9c9c0;font-size:12px;line-height:18px'>Plan together. Go farther.</div></td></tr></table><div style='padding-top:34px;color:#f5c77b;font-size:11px;line-height:16px;font-weight:800;letter-spacing:2px;text-transform:uppercase'>Password recovery</div><h1 style='margin:9px 0 0;color:#ffffff;font-size:36px;line-height:42px;letter-spacing:-1px'>Let’s get you back on the trail.</h1></td></tr><tr><td style='padding:38px 40px 22px'><p style='margin:0 0 18px;font-size:16px;line-height:26px'>Hi {{ EMAIL }},</p><p style='margin:0 0 28px;color:#4e5c54;font-size:16px;line-height:26px'>We received a request to reset your {{ APP_NAME }} password. Choose a new one and you’ll be back to planning in no time.</p><table role='presentation' cellspacing='0' cellpadding='0' border='0'><tr><td bgcolor='#f1b85b' style='border-radius:12px'><a href='{{ SITE_URL }}/_/auth/reset_password/update/{{ TOKEN }}' style='display:inline-block;padding:15px 24px;color:#173b2d;font-size:15px;line-height:20px;font-weight:800;text-decoration:none'>Choose a new password &rarr;</a></td></tr></table><p style='margin:28px 0 8px;color:#68716b;font-size:12px;line-height:19px'>Button not working? Copy and paste this secure link:</p><p style='margin:0;overflow-wrap:anywhere;word-break:break-word;font-size:12px;line-height:19px'><a href='{{ SITE_URL }}/_/auth/reset_password/update/{{ TOKEN }}' style='color:#1c6748;text-decoration:underline'>{{ SITE_URL }}/_/auth/reset_password/update/{{ TOKEN }}</a></p></td></tr><tr><td style='padding:18px 40px 34px'><table role='presentation' width='100%' cellspacing='0' cellpadding='0' border='0' bgcolor='#eeece4' style='border-radius:12px'><tr><td style='padding:17px 18px;color:#5c665f;font-size:13px;line-height:20px'><strong style='color:#173b2d'>Didn’t request a reset?</strong><br>You can safely ignore this email. Your existing password will continue to work.</td></tr></table></td></tr><tr><td align='center' bgcolor='#173b2d' style='padding:24px 32px;color:#9fb2a7;font-size:12px;line-height:19px'>Sent by Trailhead &middot; Built for the journeys worth sharing.<br><a href='{{ SITE_URL }}' style='color:#f5c77b;text-decoration:none'>{{ SITE_URL }}</a></td></tr></table></td></tr></table></body></html>"
  }
  otp_template {
    subject: "Your {{ APP_NAME }} sign-in code"
    body: "<!doctype html><html lang='en'><body style='margin:0;padding:0;background:#f7f5ef;color:#18211c;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Arial,sans-serif'><div style='display:none;max-height:0;overflow:hidden;opacity:0'>Use this one-time code to securely sign in to Trailhead.</div><table role='presentation' width='100%' cellspacing='0' cellpadding='0' border='0' bgcolor='#f7f5ef'><tr><td align='center' style='padding:36px 16px'><table role='presentation' width='600' cellspacing='0' cellpadding='0' border='0' style='width:100%;max-width:600px;background:#fffefb;border:1px solid #dedbd0;border-radius:20px;overflow:hidden'><tr><td height='6' bgcolor='#f1b85b' style='font-size:0;line-height:0'>&nbsp;</td></tr><tr><td bgcolor='#173b2d' style='padding:30px 40px 34px'><table role='presentation' cellspacing='0' cellpadding='0' border='0'><tr><td style='padding-right:13px'><img src='{{ SITE_URL }}/trailhead-logo-email.png' width='48' height='48' alt='' style='display:block;border:0;border-radius:14px'></td><td><div style='color:#ffffff;font-size:21px;line-height:25px;font-weight:800;letter-spacing:-.3px'>Trailhead</div><div style='color:#b9c9c0;font-size:12px;line-height:18px'>Plan together. Go farther.</div></td></tr></table><div style='padding-top:34px;color:#f5c77b;font-size:11px;line-height:16px;font-weight:800;letter-spacing:2px;text-transform:uppercase'>Secure sign-in</div><h1 style='margin:9px 0 0;color:#ffffff;font-size:36px;line-height:42px;letter-spacing:-1px'>Your sign-in code is ready.</h1></td></tr><tr><td style='padding:38px 40px 22px'><p style='margin:0 0 18px;font-size:16px;line-height:26px'>Hi {{ EMAIL }},</p><p style='margin:0 0 24px;color:#4e5c54;font-size:16px;line-height:26px'>Enter this one-time code to securely sign in to {{ APP_NAME }}:</p><table role='presentation' width='100%' cellspacing='0' cellpadding='0' border='0' bgcolor='#eeece4' style='border:1px solid #dedbd0;border-radius:14px'><tr><td align='center' style='padding:24px 16px;color:#173b2d;font-family:Menlo,Consolas,monospace;font-size:34px;line-height:40px;font-weight:800;letter-spacing:7px'>{{ CODE }}</td></tr></table><table role='presentation' cellspacing='0' cellpadding='0' border='0' style='margin-top:24px'><tr><td bgcolor='#f1b85b' style='border-radius:12px'><a href='{{ SITE_URL }}/_/auth/otp/login' style='display:inline-block;padding:15px 24px;color:#173b2d;font-size:15px;line-height:20px;font-weight:800;text-decoration:none'>Open secure sign-in &rarr;</a></td></tr></table></td></tr><tr><td style='padding:18px 40px 34px'><table role='presentation' width='100%' cellspacing='0' cellpadding='0' border='0' bgcolor='#eeece4' style='border-radius:12px'><tr><td style='padding:17px 18px;color:#5c665f;font-size:13px;line-height:20px'><strong style='color:#173b2d'>Keep this code private.</strong><br>Trailhead support will never ask you to share it. If you didn’t request it, ignore this email.</td></tr></table></td></tr><tr><td align='center' bgcolor='#173b2d' style='padding:24px 32px;color:#9fb2a7;font-size:12px;line-height:19px'>Sent by Trailhead &middot; Built for the journeys worth sharing.<br><a href='{{ SITE_URL }}' style='color:#f5c77b;text-decoration:none'>{{ SITE_URL }}</a></td></tr></table></td></tr></table></body></html>"
  }
}
server {
  application_name: "Trailhead"
  site_url: "http://localhost:4000"
  logs_retention_sec: 604800
}
auth {
  auth_token_ttl_sec: 3600
  refresh_token_ttl_sec: 2592000
  enable_otp_signin: true
  enable_anonymous_signin: true
}
jobs {}
record_apis: [
  {
    name: "profiles"
    table_name: "profiles"
    conflict_resolution: REPLACE
    acl_authenticated: [CREATE, READ, UPDATE, DELETE]
    create_access_rule: "_REQ_.user = _USER_.id"
    read_access_rule: "_ROW_.user = _USER_.id OR EXISTS(SELECT 1 FROM trip_members me JOIN trip_members them ON them.trip_id = me.trip_id WHERE me.user_id = _USER_.id AND them.user_id = _ROW_.user)"
    update_access_rule: "_ROW_.user = _USER_.id AND 'user' NOT IN _REQ_FIELDS_"
    delete_access_rule: "_ROW_.user = _USER_.id"
  },
  {
    name: "trips"
    table_name: "trips"
    acl_authenticated: [READ, UPDATE, DELETE]
    read_access_rule: "EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.id AND user_id = _USER_.id)"
    update_access_rule: "'id' NOT IN _REQ_FIELDS_ AND 'owner' NOT IN _REQ_FIELDS_ AND EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.id AND user_id = _USER_.id AND role IN ('owner', 'editor'))"
    delete_access_rule: "EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.id AND user_id = _USER_.id AND role = 'owner')"
  },
  {
    name: "trip_members"
    table_name: "trip_members"
    acl_authenticated: [READ, UPDATE, DELETE]
    enable_subscriptions: true
    read_access_rule: "EXISTS(SELECT 1 FROM trip_members me WHERE me.trip_id = _ROW_.trip_id AND me.user_id = _USER_.id)"
    update_access_rule: "_ROW_.role != 'owner' AND 'id' NOT IN _REQ_FIELDS_ AND 'trip_id' NOT IN _REQ_FIELDS_ AND 'user_id' NOT IN _REQ_FIELDS_ AND EXISTS(SELECT 1 FROM trip_members me WHERE me.trip_id = _ROW_.trip_id AND me.user_id = _USER_.id AND me.role = 'owner')"
    delete_access_rule: "_ROW_.role != 'owner' AND EXISTS(SELECT 1 FROM trip_members me WHERE me.trip_id = _ROW_.trip_id AND me.user_id = _USER_.id AND me.role = 'owner')"
  },
  {
    name: "trip_members_view"
    table_name: "trip_members_view"
    acl_authenticated: [READ]
    enable_subscriptions: true
    read_access_rule: "EXISTS(SELECT 1 FROM trip_members me WHERE me.trip_id = _ROW_.trip_id AND me.user_id = _USER_.id)"
  },
  {
    name: "itinerary_items"
    table_name: "itinerary_items"
    acl_authenticated: [CREATE, READ, UPDATE, DELETE]
    enable_subscriptions: true
    create_access_rule: "_REQ_.created_by = _USER_.id AND EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _REQ_.trip_id AND user_id = _USER_.id AND role IN ('owner', 'editor'))"
    read_access_rule: "EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.trip_id AND user_id = _USER_.id)"
    update_access_rule: "'id' NOT IN _REQ_FIELDS_ AND 'trip_id' NOT IN _REQ_FIELDS_ AND 'created_by' NOT IN _REQ_FIELDS_ AND EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.trip_id AND user_id = _USER_.id AND role IN ('owner', 'editor'))"
    delete_access_rule: "EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.trip_id AND user_id = _USER_.id AND role IN ('owner', 'editor'))"
  },
  {
    name: "checklist_items"
    table_name: "checklist_items"
    acl_authenticated: [CREATE, READ, UPDATE, DELETE]
    enable_subscriptions: true
    create_access_rule: "_REQ_.created_by = _USER_.id AND EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _REQ_.trip_id AND user_id = _USER_.id AND role IN ('owner', 'editor')) AND (_REQ_.assigned_to IS NULL OR EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _REQ_.trip_id AND user_id = _REQ_.assigned_to))"
    read_access_rule: "EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.trip_id AND user_id = _USER_.id)"
    update_access_rule: "'id' NOT IN _REQ_FIELDS_ AND 'trip_id' NOT IN _REQ_FIELDS_ AND 'created_by' NOT IN _REQ_FIELDS_ AND EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.trip_id AND user_id = _USER_.id AND role IN ('owner', 'editor')) AND (_REQ_.assigned_to IS NULL OR EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.trip_id AND user_id = _REQ_.assigned_to))"
    delete_access_rule: "EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.trip_id AND user_id = _USER_.id AND role IN ('owner', 'editor'))"
  },
  {
    name: "weather_briefings"
    table_name: "weather_briefings"
    acl_authenticated: [READ]
    enable_subscriptions: true
    read_access_rule: "EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.trip_id AND user_id = _USER_.id)"
  },
  {
    name: "activity_events"
    table_name: "activity_events"
    acl_authenticated: [CREATE, READ]
    enable_subscriptions: true
    create_access_rule: "_REQ_.actor = _USER_.id AND EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _REQ_.trip_id AND user_id = _USER_.id)"
    read_access_rule: "EXISTS(SELECT 1 FROM trip_members WHERE trip_id = _ROW_.trip_id AND user_id = _USER_.id)"
  }
]
